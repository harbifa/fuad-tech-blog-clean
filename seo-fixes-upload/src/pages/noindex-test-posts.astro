---
import Layout from '../layouts/Layout.astro';

// This page adds noindex meta tags to experimental posts and redirects
const title = "صفحة غير متوفرة";
const description = "هذه الصفحة غير متوفرة للفهرسة";
---

<Layout 
  title={title} 
  description={description} 
  noindex={true}
  canonicalURL="/"
>
  <div style="text-align: center; padding: 50px; font-family: 'Tajawal', Arial, sans-serif;">
    <h1 class="text-2xl font-bold mb-4">هذه الصفحة غير متوفرة</h1>
    <p class="mb-4">سيتم توجيهك إلى الصفحة الرئيسية...</p>
    <p><a href="/" class="text-blue-600 hover:text-blue-800">العودة للرئيسية</a></p>
  </div>
  
  <!-- Auto redirect after 3 seconds -->
  <script>
    setTimeout(() => {
      window.location.href = '/';
    }, 3000);
  </script>
</Layout>
